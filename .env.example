DJANGO_SECRET_KEY=REPLACE_ME
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
PLAYER_SERVICE_LISTING_AUTO_APPROVE=false
WECHAT_APP_ID=REPLACE_ME
WECHAT_APP_SECRET=REPLACE_ME
WECHAT_CONTENT_SECURITY_ENABLED=true
WECHAT_CONTENT_SECURITY_HTTP_TIMEOUT=8
WECHAT_PHONE_NUMBER_HTTP_TIMEOUT=8
WECHAT_MESSAGE_TOKEN=REPLACE_WITH_WECHAT_MESSAGE_PUSH_TOKEN
WECHAT_MESSAGE_ENCODING_AES_KEY=
ENABLE_DEV_OPENID_LOGIN=false
ENABLE_MOCK_PAYMENT=false
WECHATPAY_MCH_ID=REPLACE_ME
WECHATPAY_MERCHANT_SERIAL_NO=REPLACE_ME
WECHATPAY_MERCHANT_PRIVATE_KEY_PATH=REPLACE_WITH_MERCHANT_PRIVATE_KEY_PATH
WECHATPAY_API_V3_KEY=REPLACE_WITH_EXACTLY_32_BYTES
WECHATPAY_PUBLIC_KEY_ID=PUB_KEY_ID_REPLACE_ME
WECHATPAY_PUBLIC_KEY_PATH=REPLACE_WITH_WECHATPAY_PUBLIC_KEY_PATH
WECHATPAY_NOTIFY_URL=REPLACE_WITH_HTTPS_NOTIFY_URL
WECHATPAY_DESCRIPTION_PREFIX=偷吃俱乐部-
WECHATPAY_HTTP_TIMEOUT=10
WECHATPAY_TIMESTAMP_TOLERANCE_SECONDS=300

# 微信小程序虚拟支付 / XPay。
# iOS Apple 虚拟支付只能走正式环境，生产务必使用 WECHAT_VIRTUALPAY_ENV=0。
WECHAT_VIRTUALPAY_ENABLED=true
WECHAT_VIRTUALPAY_ENV=0
WECHAT_VIRTUALPAY_OFFER_ID=REPLACE_ME
WECHAT_VIRTUALPAY_APP_KEY=REPLACE_ME
WECHAT_VIRTUALPAY_HTTP_TIMEOUT=10
# 微信公众平台代币已经联调发布为：1人民币 = 10代币。
# 业务展示同样保持 1人民币 = 10钻石，因此 1个微信官方代币 = 1钻石 = 0.10元。
# 该发布比例已经锁定；后端新XPay请求固定按1:10执行，不再允许用环境变量切到1:100。
WECHAT_VIRTUALPAY_COIN_UNITS_PER_YUAN=10
# iOS 虚拟支付默认开启；需要紧急熔断时可改 false。
IOS_PURCHASE_ENABLED=true
# 渠道费率不要写死在业务代码。当前默认保守按 iOS 15%、其他端 1%。
WECHAT_VIRTUALPAY_IOS_FEE_PERCENT=15.00
WECHAT_VIRTUALPAY_OTHER_FEE_PERCENT=1.00
# 俱乐部希望扣除支付渠道费后仍保留的目标毛利率。
CLUB_TARGET_NET_MARGIN_PERCENT=15.00
# 微信官方代币是整数且发布比例为1:10，因此现金充值最小颗粒度为0.10元。
# 人民币订单/历史账务仍可精确保存到分，但不可把不能整除0.10元的金额直接提交给XPay。
WECHAT_VIRTUALPAY_RECHARGE_MIN_YUAN=0.10
WECHAT_VIRTUALPAY_RECHARGE_MAX_YUAN=5000.00

WECHAT_PLAYER_ORDER_TEMPLATE_ID=AhMjmuvib1HCABMK48XFaIUNWI2vKfjTSUFX-hXHNlw
WECHAT_PLAYER_ORDER_TEMPLATE_PAGE=pages/player/grab/index
WECHAT_PLAYER_ORDER_TEMPLATE_FIELDS={"amount1":"{total_amount}","thing2":"{notification_note}","time3":"{created_at}","character_string4":"{order_no}","thing5":"{package_name}"}
WECHAT_SUBSCRIBE_MESSAGE_MINIPROGRAM_STATE=formal

# 腾讯云短信：签名、模板审核通过后再开启。
TENCENT_SMS_ENABLED=false
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# 参数顺序必须与腾讯云短信模板变量顺序一致，可用 order_no/deadline/package_name/spec_name/player_name/booked_hours/total_amount。
TENCENT_SMS_TEMPLATE_PARAMS=["{order_no}","{deadline}"]
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_HTTP_TIMEOUT=8
